# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Jira / Trello sandbox ---
JIRA_BASE_URL=https://your-sandbox.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Trello (Agent 2). How to get them: see agent2_ops/README.md
TRELLO_API_KEY=
TRELLO_API_TOKEN=
# Optional: write into an existing board instead of creating/reusing one by name
# (board id = the part after /b/ in the board URL).
TRELLO_BOARD_ID=

# --- Agent 2 settings (all optional, defaults are fine) ---
# embeddings = sentence-transformers matcher (downloads a small model on first run)
# keywords   = simple word overlap, no download
SKILL_MATCHER=embeddings
# SKILL_MODEL=sentence-transformers/all-MiniLM-L6-v2   # later: path of the fine-tuned model
# MATCH_MIN_CONFIDENCE=0.15   # below this a story is NOT assigned -> a human decides
# SPRINT_CAPACITY=            # story points per sprint (default = sum of team capacities)
# AUDIT_LOG_PATH=             # default agent2_ops/audit_log.jsonl

# --- MLflow (matches docker-compose.yml defaults) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Chroma (matches docker-compose.yml defaults) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- SLM fine-tuning (M2), if calling a hosted API for baseline comparison ---
HF_TOKEN=

# --- LLM (Agent 1) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash


# --- RAG (Chroma). Defaults are fine: local folder .chroma ---
# CHROMA_USE_SERVER=1 uses the docker compose chroma service instead.
CHROMA_USE_SERVER=0
CHROMA_PATH=.chroma

