# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Jira / Trello sandbox ---
JIRA_BASE_URL=https://your-sandbox.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

TRELLO_API_KEY=
TRELLO_API_TOKEN=

# --- MLflow (matches docker-compose.yml defaults) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Chroma (matches docker-compose.yml defaults) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- SLM fine-tuning (M2), if calling a hosted API for baseline comparison ---
HF_TOKEN=
